# Copy to ../.env.local (app root) and fill in by hand. On a host, set the same names in its environment settings.
# FEATHERLESS_API_KEY: Featherless key for model calls (forming groups, rewriting rules, profile summaries). Required.
FEATHERLESS_API_KEY=
# APIFY_TOKEN: Apify token for reading LinkedIn and website pages (and the optional name search). Required.
APIFY_TOKEN=
# ORGANISER_SECRET: password for /organiser and the sponsor test routes (header x-organiser-secret). Choose a long random value. Required.
ORGANISER_SECRET=
# SPONSOR_MODE: live, or replay to answer the organiser test routes (/api/apify, /api/featherless) from a recording made in live mode; attendee calls are always live. Required.
SPONSOR_MODE=
# POSTHOG_KEY: PostHog project key (project token). Required.
POSTHOG_KEY=
# POSTHOG_HOST: https://eu.i.posthog.com or https://us.i.posthog.com, matching your PostHog region. Required.
POSTHOG_HOST=
# GITHUB_TOKEN: a GitHub personal access token with no scopes; raises the profile-read limit from 60 to 5000 requests an hour. Optional.
GITHUB_TOKEN=
# NAME_SEARCH: on to search LinkedIn by name through Apify for joiners who give no LinkedIn link and ask them "Is this you?"; anything else is off. Optional; off by default.
NAME_SEARCH=
# EVENT_CODE: a fixed four-digit event code, so the code people saw survives a restart. Optional; random otherwise.
EVENT_CODE=
# APIFY_TOKEN_FILE / FEATHERLESS_API_KEY_FILE: path to a file holding the key, used when the variable above is unset (local only). Optional.
APIFY_TOKEN_FILE=
FEATHERLESS_API_KEY_FILE=
# SPONSOR_REPLAY_FILE: path of the replay recording, default replay/sponsor-calls.json. Optional.
SPONSOR_REPLAY_FILE=
